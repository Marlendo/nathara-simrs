# Nathara SIMRS frontend — bun-first (migrasi dari pnpm).
FROM oven/bun:1 AS base
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=https://simrs.nathara.ac.id
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY package.json bun.lock* ./
COPY apps/frontend/package.json apps/frontend/
RUN bun install --frozen-lockfile
COPY . .
RUN bun --filter @simrs/frontend build
FROM oven/bun:1-slim AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=base /app/apps/frontend/.next ./apps/frontend/.next
COPY --from=base /app/apps/frontend/public ./apps/frontend/public
COPY --from=base /app/apps/frontend/package.json ./apps/frontend/
COPY --from=base /app/node_modules ./node_modules
EXPOSE 3000
CMD ["bun", "--filter", "@simrs/frontend", "start"]
