SSO_CLOCK_SKEW_S=60
R2_ENDPOINT=https://ISI_DARI_VPS
R2_ACCESS_KEY_ID=ISI_DARI_VPS
R2_SECRET_ACCESS_KEY=ISI_DARI_VPS
R2_BUCKET=nathara-simrs
ENCRYPTION_KEY=ISI_DARI_VPS_base64_32B
ENCRYPTION_SEARCH_KEY=ISI_DARI_VPS_base64_32B
BACKUP_ENCRYPTION_KEY=ISI_DARI_VPS_base64_32B
