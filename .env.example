# Nathara SIMRS — contoh dev (TANPA nilai prod; JWT/MINIO/SEED lama DIHAPUS)
APP_URL=http://localhost:3050
DATABASE_URL=postgresql://simrs_app:ISI_DARI_VPS@localhost:5436/simrs?schema=public
SUPABASE_URL=https://api.nathara.ac.id
SUPABASE_JWKS_URL=https://api.nathara.ac.id/.well-known/jwks.json
SUPABASE_ISSUER=https://api.nathara.ac.id
# SUPABASE_AUDIENCE= (isi bila PM Production menetapkan; JANGAN karang)
