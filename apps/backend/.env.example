# Nathara SIMRS backend — contoh dev TANPA nilai prod (JWT/MINIO/SEED lama DIHAPUS).
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
APP_URL=http://localhost:3050
DATABASE_URL=postgresql://simrs_app:ISI_DARI_VPS@localhost:5436/simrs?schema=public
# REDIS_URL opsional (hanya rate-limit/cache non-auth, reuse sentral bila dipakai)
SUPABASE_URL=https://api.nathara.ac.id
SUPABASE_JWKS_URL=https://api.nathara.ac.id/.well-known/jwks.json
SUPABASE_ISSUER=https://api.nathara.ac.id
# SUPABASE_AUDIENCE= (isi bila PM Production menetapkan; JANGAN karang)
SSO_JWKS_TTL_MS=600000
SSO_CLOCK_SKEW_S=60
R2_ENDPOINT=https://ISI_DARI_VPS
R2_ACCESS_KEY_ID=ISI_DARI_VPS
R2_SECRET_ACCESS_KEY=ISI_DARI_VPS
R2_BUCKET=nathara-simrs
SWAGGER_PATH=docs
ENCRYPTION_KEY=ISI_DARI_VPS_base64_32B
ENCRYPTION_SEARCH_KEY=ISI_DARI_VPS_base64_32B
BACKUP_ENCRYPTION_KEY=ISI_DARI_VPS_base64_32B
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=info
# TODO VERIFIKASI_PM_PROD: iss/aud/JWKS URL eksak dari PM Production.
