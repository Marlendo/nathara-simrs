# Nathara SIMRS PROD-EFEKTIF — contoh TANPA nilai asli (kunci HANYA via file VPS).
# service_role prod + secret lama DILARANG ada di file/env/log.
APP_URL=https://simrs.nathara.ac.id
CORS_ORIGIN=https://simrs.nathara.ac.id
DATABASE_URL=postgresql://simrs_app:ISI_DARI_VPS@staging-postgres-18:5432/simrs?schema=public
SUPABASE_URL=https://api.nathara.ac.id
SUPABASE_JWKS_URL=ISI_DARI_PM_PROD_JWKS_URL
SUPABASE_ISSUER=ISI_DARI_PM_PROD_ISSUER
# SUPABASE_AUDIENCE=ISI_DARI_PM_PROD_BILA_ADA
SSO_JWKS_TTL_MS=600000
SSO_CLOCK_SKEW_S=60
R2_ENDPOINT=ISI_DARI_VPS
R2_ACCESS_KEY_ID=ISI_DARI_VPS
R2_SECRET_ACCESS_KEY=ISI_DARI_VPS
R2_BUCKET=nathara-simrs
# R2_PUBLIC_URL=ISI_OPSIONAL
ENCRYPTION_KEY=ISI_DARI_VPS_base64_32B
ENCRYPTION_SEARCH_KEY=ISI_DARI_VPS_base64_32B
BACKUP_ENCRYPTION_KEY=ISI_DARI_VPS_base64_32B
NEXT_PUBLIC_API_URL=https://simrs.nathara.ac.id
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=info
SWAGGER_PATH=docs
