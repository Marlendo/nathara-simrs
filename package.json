{
  "name": "simrs-monorepo",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun x turbo run dev --parallel",
    "dev:frontend": "bun --filter @simrs/frontend dev",
    "dev:backend": "bun --filter @simrs/backend dev",
    "build": "bun x turbo run build",
    "start": "turbo run start",
    "lint": "bun x turbo run lint",
    "typecheck": "bun x turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bun --filter @simrs/db db:generate",
    "db:migrate": "bun --filter @simrs/db db:migrate",
    "db:migrate:dev": "bun --filter @simrs/db db:migrate:dev",
    "db:seed": "node -e \"console.error('[seed] DILARANG');process.exit(1)\"",
    "db:setup": "bash scripts/db-setup.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "setup": "bash scripts/setup-local.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres redis minio",
    "docker:db-setup": "docker compose -f docker-compose.yml -f docker-compose.setup.yml --profile setup run --rm db-setup",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml --env-file .env.production build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f nginx backend frontend",
    "test:policy": "bun --filter @simrs/db exec tsx ../../apps/backend/test/policy.engine.test.ts",
    "docs:inject": "bun --filter @simrs/db exec tsx ../../scripts/inject-file-documentation.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
